@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=3DRoboto+Condensed:wg=
ht@400;700&family=3DRoboto:wght@400;700&display=3Dswap");

:root { --footer-dt-text-color: #e2e5ea; --footer-dt-border-color: #4a535a;=
 --footer-lt-text-color: #303336; --footer-lt-border-color: #acb6ba; }

.flv6 { font-family: Roboto, sans-serif; }

.flv6-heading { font-family: "Roboto Condensed", sans-serif; }

.flv6 .container-fluid { max-width: 1440px; }

.flv6-ad { background-color: rgb(239, 240, 242); }

.flv6-nav a { font-size: 0.9rem; }

.flv6-nav span.material-symbols-outlined { transform: rotate(0deg); transit=
ion: transform 0.2s ease-in-out; }

.flv6-nav span.material-symbols-outlined.__active { transform: rotate(90deg=
); }

.flv6 .email-only-reg { display: flex; flex-direction: column; }

.flv6 .email-only-reg-wrapper { display: flex; flex-direction: column; alig=
n-items: center; }

@media (min-width: 992px) {
  .flv6 .email-only-reg { display: block; }
  .flv6 .email-only-reg__form__label { margin-right: 1rem; margin-bottom: 0=
px; }
  .flv6 .email-only-reg-wrapper { flex-direction: row; }
}

